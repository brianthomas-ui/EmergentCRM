# ─────────────────────────────────────────────────────────────────────────────
# EmergentCRM backend environment.  Copy to backend/.env and fill in.
# The app is demo-safe with ZERO integration keys (every integration falls back
# to a mock). Set APP_MODE=production + the keys below to go live.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED (boot fails fast in production if missing/weak) ──
MONGO_URL=mongodb://localhost:27017
DB_NAME=emergent_crm
JWT_SECRET=change-me-min-32-chars-random            # >= 32 chars in production
INTEGRATION_ENC_KEY=change-me-distinct-from-jwt     # encrypts stored integration keys; MUST differ from JWT_SECRET
CORS_ORIGINS=http://localhost:3000                  # explicit FE origin(s), comma-separated; never '*' in production
PUBLIC_BASE_URL=http://localhost:8001               # server's public URL; used to build webhook/success URLs
APP_MODE=demo                                       # demo | production  (production disables all demo/reseed paths)

# ── ADMIN bootstrap (production seeds ONLY this admin; agents are invited via the UI) ──
ADMIN_EMAIL=diyea@emergent.sh
ADMIN_PASSWORD=change-me-strong

# ── OPTIONAL integrations — each activates a real integration; absent = mock/demo ──
# Keys may also be set at runtime via Settings → Integrations (encrypted at rest);
# stored keys take precedence over these env vars.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CALENDLY_TOKEN=
CALENDLY_WEBHOOK_SIGNING_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_ORGANISER_FALLBACK_EMAIL=                    # used when an agent has no Workspace identity (Meet still created)
CIRCLEBACK_API_KEY=
CIRCLEBACK_API_URL=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
EMERGENT_USERS_API_URL=
EMERGENT_USERS_API_KEY=

# ── DEMO-only (ignored in production) ──
DEMO_EMAIL=demo@emergent.sh
DEMO_PASSWORD=demo12345
EMERGENT_SIM_AUTOPAY=true                            # auto-complete simulated Stripe payments to Won (local demo only)
