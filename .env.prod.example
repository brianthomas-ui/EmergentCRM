# Production env for docker-compose.prod.yml.  Copy to .env.prod and fill in.
#   cp .env.prod.example .env.prod
# Generate the two secrets (must be different from each other):
#   openssl rand -base64 48        # -> JWT_SECRET
#   openssl rand -base64 48        # -> INTEGRATION_ENC_KEY

# ── Mode ─────────────────────────────────────────────────────────────────────
# demo       = the full showcase: rich $100k/agent demo data, leaderboard, and the
#              landing "Demo View" button all work. Use this for emergentcrm.com as a demo.
# production = real instance: seeds ONLY the admin, no demo data, all destructive/demo
#              paths OFF, and the strict config asserts below become MANDATORY.
APP_MODE=demo

# ── Core (required) ──────────────────────────────────────────────────────────
DB_NAME=emergent_crm
JWT_SECRET=CHANGE_ME_min_32_chars_use_openssl_rand
INTEGRATION_ENC_KEY=CHANGE_ME_DIFFERENT_from_JWT_SECRET
PUBLIC_BASE_URL=https://emergentcrm.com
CORS_ORIGINS=https://emergentcrm.com

# Admin login (seeded once). In production the password is NOT reset on later boots.
ADMIN_EMAIL=diyea@emergent.sh
ADMIN_PASSWORD=CHANGE_ME_strong_password

# ── Demo-only (ignored when APP_MODE=production) ─────────────────────────────
DEMO_EMAIL=demo@emergent.sh
DEMO_PASSWORD=demo12345
# Simulate card payments so the demo's payment links "complete" without real keys.
EMERGENT_SIM_AUTOPAY=true

# ── Optional integrations (all degrade gracefully if unset; needed only for REAL money/cal) ──
# STRIPE_API_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# RAZORPAY_KEY_ID=rzp_live_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...
# CALENDLY_WEBHOOK_SIGNING_KEY=...
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# EMERGENT_USERS_API_URL=https://api.emergent.sh/users
